generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  currency      String          @default("PKR")
  creditLimit   Float           @default(0)
  accounts      Account[]
  sessions      Session[]
  transactions  Transaction[]
  budgets       Budget[]
  subscriptions Subscription[]
  savingsGoals     SavingsGoal[]
  customCategories CustomCategory[]
  notes            Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  type        String   // "income" or "expense"
  category    String
  spendType   String   @default("UNCATEGORIZED") // "NEED", "WANT", "SAVING", "UNCATEGORIZED"
  paymentMethod String @default("cash") // "cash" or "credit"
  date        String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Budget {
  id        String   @id @default(uuid())
  category  String
  amount    Float
  month     String   // Format: YYYY-MM
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, month])
}

model Subscription {
  id           String   @id @default(uuid())
  name         String
  amount       Float
  billingCycle String   // "monthly" | "yearly"
  type         String   @default("subscription") // "subscription" | "bill" | "installment"
  nextDueDate  String?  // Format: YYYY-MM-DD
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SavingsGoal {
  id            String   @id @default(uuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      String?  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomCategory {
  id        String   @id @default(uuid())
  name      String
  icon      String
  color     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Note {
  id        String   @id @default(uuid())
  title     String?
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
